<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/howTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center|start"
        android:text="여행지는 어땠나요? "
        android:textAppearance="@style/PostReviewPhotoTextApperance"
        app:layout_constraintBottom_toTopOf="@id/rotationRatingBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="0.05" />

    <com.willy.ratingbar.RotationRatingBar
        android:id="@+id/rotationRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/howTextView"
        app:layout_constraintVertical_weight="0.05"
        app:srb_clearRatingEnabled="true"
        app:srb_clickable="true"
        app:srb_isIndicator="false"
        app:srb_minimumStars="0"
        app:srb_numStars="5"
        app:srb_rating="0"
        app:srb_scrollable="true"
        app:srb_starHeight="30dp"
        app:srb_starPadding="15dp"
        app:srb_starWidth="30dp"
        app:srb_stepSize="1" />

    <TextView
        android:id="@+id/ShowYourPlacePhotoTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center|start"
        android:text="여행지를 보여주세요!"
        android:textAppearance="@style/PostReviewPhotoTextApperance"
        app:layout_constraintBottom_toTopOf="@id/ShowPlaceImageViewPager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rotationRatingBar"
        app:layout_constraintVertical_weight="0.1" />

    <LinearLayout
        android:id="@+id/addPhotoLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/showPlaceIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ShowYourPlacePhotoTextView"
        app:layout_constraintVertical_weight="0.68">

        <ImageButton
            android:id="@+id/addPhotoBtn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pick_photo_style"
            android:src="@drawable/vector" />
    </LinearLayout>


    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ShowPlaceImageViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/showPlaceIndicator"
        app:layout_constraintCircleRadius="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ShowYourPlacePhotoTextView"
        app:layout_constraintVertical_weight="0.68" />

    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/showPlaceIndicator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:dotsColor="#D9D9D9"
        app:layout_constraintBottom_toTopOf="@id/ConfirmBtnForPostReview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ShowPlaceImageViewPager"
        app:layout_constraintVertical_weight="0.05"
        app:selectedDotColor="#31511E" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/ConfirmBtnForPostReview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/button_style"
        android:text="사진선택"
        android:textAppearance="@style/BtnTextApperance"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/showPlaceIndicator"
        app:layout_constraintVertical_weight="0.08" />


</androidx.constraintlayout.widget.ConstraintLayout>