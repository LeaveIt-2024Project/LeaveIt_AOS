<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/topContentLayer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/imageViewPager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="0.1">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.1"
            android:src="@drawable/ic_launcher_background" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5">

            <TextView
                android:id="@+id/userNinckName"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:gravity="center"
                android:text="사용자닉네임"
                app:layout_constraintBottom_toTopOf="@id/placeRegionText"
                app:layout_constraintEnd_toStartOf="@id/likeBtn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/placeRegionText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="경기도"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userNinckName" />

            <TextView
                android:id="@+id/regiDateText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="2024. 11. 06"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/placeRegionText"
                app:layout_constraintTop_toBottomOf="@id/userNinckName" />

            <ImageButton
                android:id="@+id/likeBtn"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/white"
                android:src="@drawable/chat_btn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/likeCountText"
                app:layout_constraintStart_toEndOf="@id/regiDateText"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/likeCountText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:gravity="center"
                android:text="7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/starImage"
                app:layout_constraintStart_toEndOf="@id/likeBtn"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/starImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/star_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/starCountText"
                app:layout_constraintStart_toEndOf="@id/likeCountText"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/starCountText"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/starImage"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imageViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/reviewIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topContentLayer"
        app:layout_constraintVertical_weight="0.6" />

    <me.relex.circleindicator.CircleIndicator3
        android:id="@+id/reviewIndicator"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/contentTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageViewPager"
        app:layout_constraintVertical_weight="0.05" />

    <TextView
        android:id="@+id/contentTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reviewIndicator"
        app:layout_constraintVertical_weight="0.3" />
</androidx.constraintlayout.widget.ConstraintLayout>