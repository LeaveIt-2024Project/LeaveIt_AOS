<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/myProfileChgImg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/gyeonggyi"
        app:layout_constraintVertical_weight="0.3"
        app:civ_circle_background_color="@color/tema3"
        app:layout_constraintBottom_toTopOf="@id/changeText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/changeText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/change_Img"
        android:gravity="center"
        android:textAppearance="@style/changeImg"
        app:layout_constraintVertical_weight="0.1"
        app:layout_constraintBottom_toTopOf="@id/preferRegionText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myProfileChgImg" />

    <TextView
        android:id="@+id/preferRegionText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:text="선호 지역"
        android:layout_marginLeft="10sp"
        android:gravity="start"
        android:textAppearance="@style/preferRgo"
        app:layout_constraintVertical_weight="0.05"
        app:layout_constraintBottom_toTopOf="@id/chooseRegion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/changeText" />

    <Spinner
        android:id="@+id/chooseRegion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="10sp"
        app:layout_constraintVertical_weight="0.2"
        app:layout_constraintBottom_toTopOf="@id/passwordChgBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preferRegionText"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/passwordChgBtn"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:background="@drawable/button_style"
        android:text="비밀번호 변경"
        android:textAppearance="@style/passwdChgBtnTextApperance"
        app:layout_constraintVertical_weight="0.1"
        app:layout_constraintBottom_toTopOf="@id/blankSpace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chooseRegion" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blankSpace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordChgBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>