<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/ShowPlaceImageViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/showPlaceIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="0.45" />

    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/showPlaceIndicator"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:dotsColor="#D9D9D9"
        app:layout_constraintBottom_toTopOf="@id/inputContentForReviewEditText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ShowPlaceImageViewPager"
        app:layout_constraintVertical_weight="0.05"
        app:selectedDotColor="#31511E" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputContentForReviewEditText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:hint="내용을 입력하세요"
        app:boxBackgroundColor="#FFFF"
        app:boxStrokeWidth="0dp"
        app:layout_constraintBottom_toTopOf="@id/writeContentConfirmBtnForPostReview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/showPlaceIndicator"
        app:layout_constraintVertical_weight="0.43">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/writeContentForReviewEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textAppearance="@style/inputTextForReviewContent"
            android:gravity="top"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/writeContentConfirmBtnForPostReview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/button_style"
        android:text="사진선택"
        android:textAppearance="@style/BtnTextApperance"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputContentForReviewEditText"
        app:layout_constraintVertical_weight="0.08" />

</androidx.constraintlayout.widget.ConstraintLayout>